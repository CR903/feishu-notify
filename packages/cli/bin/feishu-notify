#!/bin/bash
# ============================================================
# feishu-notify — 全局飞书通知脚本
# 安装: ~/.local/bin/feishu-notify
#
# 用法:
#   feishu-notify "消息内容"
#   feishu-notify --title "标题" $'多行\n内容'
#   feishu-notify --text "纯文本（无格式）"
#   feishu-notify --file /path/to/file.txt
#   feishu-notify --hook           # Stop hook 专用（读取 stdin JSON）
#   feishu-notify --idle           # Notification idle hook 专用（读取 stdin JSON）
#   feishu-notify --done           # Stop hook 专用（读取 stdin JSON + 含结果内容）
#   feishu-notify --source "指定来源"  # 覆盖自动检测的客户端来源
#   feishu-notify --webhook "URL"  # 覆盖 webhook（最高优先，校验 https + 形状）
#   feishu-notify --channel "name" # 用配置里的指定 channel（缺省用 activeChannel）
#
# 卡片底部: footer 是配置项（顶层 footer，≤40 字符、不含换行），取值走
#   `feishu-notify-cli footer`；未配置时用中性默认 feishu-notify。
#   配置里写成空串 "" 则只显示时间戳。footer 解析失败一律回退到中性默认（装饰字段不该拦住通知）。
#
# Hook 数据流: Claude Code 将 hook 数据通过 stdin 以 JSON 格式传入
#   Stop hook → stdin: {"last_assistant_message":"...", ...}
#   Notification idle → stdin: {"prompt":"...", ...}
# ============================================================

set -euo pipefail

# ========== 配置区 ==========
# v1 起不再内置任何地址：webhook 由 `feishu-notify-cli resolve` 解析（解析逻辑只有那一份实现）
#   优先级: --webhook > --channel > FEISHU_NOTIFY_WEBHOOK > 配置 activeChannel > 报错退出(2)
#   配置文件: ${XDG_CONFIG_HOME:-$HOME/.config}/feishu-notify/config.json（FEISHU_NOTIFY_CONFIG 可覆盖）
#   解析器位置: $FEISHU_NOTIFY_CLI > 本脚本同目录的 feishu-notify-cli > $HOME/.local/bin/feishu-notify-cli > PATH
#   解释器: $FEISHU_NOTIFY_NODE > PATH 上的 node > /usr/local/bin > /opt/homebrew/bin > nvm（要求 >= 18）
# 生效时机: **发送前**才解析（无消息内容的 --done 仍静默 exit 0，不受配置影响）
WEBHOOK_URL=""          # 空 = 未用 --webhook 指定
WEBHOOK_FROM_FLAG=0
CHANNEL=""              # 空 = 用配置里的 activeChannel
# footer：卡片底部文字，取值同样来自配置（`feishu-notify-cli footer`）；这里只是兜底默认
DEFAULT_FOOTER="feishu-notify"
FOOTER=""
# ============================

FILE=""
MSG=""
TITLE=""
MSG_TYPE="card"   # card | text
TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')
HOOK_STDIN_DATA=""

# ========== 客户端检测 ==========
detect_source() {
  local source="终端"
  if [ "${TERM_PROGRAM:-}" = "vscode" ] || [ -n "${VSCODE_PID:-}" ]; then
    source="VS Code 插件端"
  elif [ -n "${ELECTRON_RUN_AS_NODE:-}" ] || [ "${CLAUDE_CODE_DESKTOP:-}" = "1" ]; then
    source="桌面端"
  fi
  echo "$source"
}

SOURCE=$(detect_source)

MSG_FOOTER=$'\n**来源**: '"${SOURCE}"$'\n🕐 '"$TIMESTAMP"

# ========== 读取 stdin hook 数据（hook 模式：stdin 有 pipe 数据）==========
HOOK_STDIN_DATA=""
# 检测 stdin 是否为 pipe（hook 模式自动 pipe JSON 数据）
if [ ! -t 0 ]; then
  HOOK_STDIN_DATA=$(cat - 2>/dev/null || true)
fi

# ========== 解析 JSON 工具函数 ==========
# 从 stdin JSON 中提取指定字段
extract_json_field() {
  local json="$1"
  local field="$2"
  echo "$json" | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    val = d.get('$field', '')
    if val:
        print(str(val)[:2000])
except:
    pass
" 2>/dev/null
}

# 解析参数
while [ $# -gt 0 ]; do
  case "$1" in
    --text) MSG_TYPE="text"; shift ;;
    --webhook) WEBHOOK_URL="$2"; WEBHOOK_FROM_FLAG=1; shift 2 ;;
    --channel) CHANNEL="$2"; shift 2 ;;
    --title) TITLE="$2"; shift 2 ;;
    --file) FILE="$2"; shift 2 ;;
    --source) SOURCE="$2"; shift 2 ;;
    --hook)
      TITLE="${SOURCE}通知"
      # 从 stdin JSON 读取 hook 数据
      if [ -n "$HOOK_STDIN_DATA" ]; then
        local_msg=$(extract_json_field "$HOOK_STDIN_DATA" "last_assistant_message")
        if [ -n "$local_msg" ]; then
          MSG="${local_msg}"$'\n—'
        else
          MSG=$'**🤖 会话已结束**'
        fi
      else
        MSG=$'**🤖 会话已结束**'
      fi
      MSG="${MSG}${MSG_FOOTER}"
      shift
      ;;
    --idle)
      TITLE="${SOURCE}通知"
      # 从 stdin JSON 读取 Notification 数据（prompt 字段）
      if [ -n "$HOOK_STDIN_DATA" ]; then
        local_msg=$(extract_json_field "$HOOK_STDIN_DATA" "prompt")
        if [ -n "$local_msg" ]; then
          MSG="${local_msg}"$'\n—'
        else
          MSG=$'**🤖 任务完成，等候输入**\n—'
        fi
      else
        MSG=$'**🤖 任务完成，等候输入**\n—'
      fi
      MSG="${MSG}${MSG_FOOTER}"
      shift
      ;;
    --done)
      TITLE="${SOURCE}通知"
      # 从 stdin JSON 读取 Stop hook 数据（last_assistant_message 字段）
      if [ -n "$HOOK_STDIN_DATA" ]; then
        local_msg=$(extract_json_field "$HOOK_STDIN_DATA" "last_assistant_message")
        if [ -n "$local_msg" ]; then
          MSG="${local_msg}"$'\n—'
        else
          # 没有消息内容 → 静默退出
          exit 0
        fi
      else
        # 无内容 → 静默退出
        exit 0
      fi
      MSG="${MSG}${MSG_FOOTER}"
      shift
      ;;
    *) MSG="$1"; shift ;;
  esac
done

# 读取文件
if [ -n "$FILE" ]; then
  [ -f "$FILE" ] || { echo "❌ 文件不存在: $FILE"; exit 1; }
  MSG=$(cat "$FILE")
fi

[ -z "$MSG" ] && {
  echo "用法: $0 <消息内容> [--text] [--title 标题] [--file <path>] [--webhook URL] [--channel name] [--source 来源] [--hook] [--idle] [--done]"
  echo ""
  echo "示例:"
  echo "  feishu-notify '任务完成'"
  echo "  feishu-notify --title '部署' $'构建成功\n已发布到测试环境'"
  echo "  feishu-notify --file result.log"
  echo "  feishu-notify --channel opencode --title 'T' --file msg.txt"
  echo "  feishu-notify --webhook 'https://open.feishu.cn/open-apis/bot/v2/hook/xxx' --title 'T' --file msg.txt"
  echo "  feishu-notify --hook"
  echo "  feishu-notify --done"
  echo ""
  echo "webhook 从配置解析（缺配置会提示先跑 npx feishu-notify-cli init）；诊断用 npx feishu-notify-cli doctor"
  echo "卡片底部 footer 也是配置项（未配置时中性默认 feishu-notify）；查看：npx feishu-notify-cli footer"
  exit 1
}

# 转义 JSON 特殊字符
escape_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\t'/\\t}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\b'/\\b}"
  s="${s//$'\f'/\\f}"
  printf '%s' "$s"
}

# 构建 JSON payload
build_payload() {
  if [ "$MSG_TYPE" = "text" ]; then
    local text; text=$(escape_json "$MSG")
    printf '{"msg_type":"text","content":{"text":"%s"}}' "$text"
  else
    local title_text="${TITLE:-${SOURCE}通知}"
    local title_escaped; title_escaped=$(escape_json "$title_text")
    local msg_escaped; msg_escaped=$(escape_json "$MSG")
    local note_text
    if [ -n "$FOOTER" ]; then
      note_text="${FOOTER} · ${TIMESTAMP}"
    else
      note_text="$TIMESTAMP"
    fi
    local note_escaped; note_escaped=$(escape_json "$note_text")

    printf '{
      "msg_type":"interactive",
      "card":{
        "header":{
          "title":{"tag":"plain_text","content":"%s"},
          "template":"blue"
        },
        "elements":[
          {"tag":"markdown","content":"%s"},
          {"tag":"hr"},
          {"tag":"note","elements":[{"tag":"plain_text","content":"%s"}]}
        ]
      }
    }' "$title_escaped" "$msg_escaped" "$note_escaped"
  fi
}

# ========== 解析 webhook（发送前才解析；解析逻辑在 feishu-notify-cli 里，只有一份实现）==========
# 放在这里的理由：`--done` 在没有消息内容时会静默 exit 0，
# 那种情况下不该因为"没配置 webhook"变成报错退出（改造前的退出码矩阵必须保持）。
NODE_MIN_MAJOR=18
NODE_BIN=""

# 解析器是 Node 脚本。hook 环境里的 PATH 不一定是登录 shell 那套，
# 而本机 /usr/local/bin/node 可能是旧版本（实测这台机器是 v14）——
# 直接调用很可能撞上"太旧的 node"，报错还看不懂。所以这里显式挑一个 >= 18 的 node。
find_node() {
  local candidate major
  for candidate in "${FEISHU_NOTIFY_NODE:-}" "$(command -v node 2>/dev/null || true)" /usr/local/bin/node /opt/homebrew/bin/node "$HOME"/.nvm/versions/node/*/bin/node; do
    [ -n "$candidate" ] && [ -x "$candidate" ] || continue
    major=$("$candidate" -e 'process.stdout.write(String(process.versions.node.split(".")[0]))' 2>/dev/null) || continue
    [ "${major:-0}" -ge "$NODE_MIN_MAJOR" ] 2>/dev/null || continue
    printf '%s' "$candidate"
    return 0
  done
  return 1
}

find_cli() {
  # 1) 显式指定
  if [ -n "${FEISHU_NOTIFY_CLI:-}" ]; then
    if [ -x "$FEISHU_NOTIFY_CLI" ]; then printf '%s' "$FEISHU_NOTIFY_CLI"; return 0; fi
    echo "❌ FEISHU_NOTIFY_CLI 指向的不是可执行文件：$FEISHU_NOTIFY_CLI" >&2
    return 1
  fi
  # 2) 与本脚本同目录（npm 安装后两个 bin 并肩，行为与 node_modules/.bin 一致）
  local here
  here=$(cd -- "$(dirname -- "$0")" 2>/dev/null && pwd -P) || here=""
  if [ -n "$here" ] && [ -x "$here/feishu-notify-cli" ]; then
    printf '%s' "$here/feishu-notify-cli"
    return 0
  fi
  # 3) ~/.local/bin（本机开发布局）
  if [ -n "${HOME:-}" ] && [ -x "$HOME/.local/bin/feishu-notify-cli" ]; then
    printf '%s' "$HOME/.local/bin/feishu-notify-cli"
    return 0
  fi
  # 4) PATH
  if command -v feishu-notify-cli >/dev/null 2>&1; then
    command -v feishu-notify-cli
    return 0
  fi
  return 1
}

resolver_error() {
  echo "❌ 未能解析 feishu webhook（见上方提示）。诊断：npx feishu-notify-cli doctor" >&2
  echo "   解析器是 Node 脚本，需要 Node >= ${NODE_MIN_MAJOR}；若提示 node 相关错误，用 FEISHU_NOTIFY_NODE 指定。" >&2
}

# 取卡片 footer（配置项 `footer`）。**尽力而为**：解析不出来就用中性默认，绝不因为一个装饰字段拦下通知。
# stdout 只有 footer 字符串；配置里明确写成空串时输出为空（含义是"只显示时间戳"）。
resolve_footer() {
  local cli out
  if ! cli=$(find_cli); then
    printf '%s' "$DEFAULT_FOOTER"
    return 0
  fi
  if [ -n "$NODE_BIN" ]; then
    if out=$("$NODE_BIN" "$cli" footer 2>/dev/null); then printf '%s' "$out"; else printf '%s' "$DEFAULT_FOOTER"; fi
  else
    if out=$("$cli" footer 2>/dev/null); then printf '%s' "$out"; else printf '%s' "$DEFAULT_FOOTER"; fi
  fi
  return 0
}

# 输出解析结果到 stdout；失败时把自己的/解析器的提示写到 stderr，并返回 2（design §2 的退出码）
resolve_webhook() {
  local cli resolved
  if ! cli=$(find_cli); then
    echo "❌ 找不到 feishu-notify-cli（webhook 解析器）。" >&2
    echo "   装一次即可：npx feishu-notify-cli init" >&2
    echo "   或用环境变量 FEISHU_NOTIFY_CLI 指定它的路径。" >&2
    return 2
  fi

  # 参数原样转发给解析器：优先级由解析器统一实现（flag > channel > env > activeChannel）
  set -- resolve
  if [ "$WEBHOOK_FROM_FLAG" = "1" ]; then set -- "$@" --webhook "$WEBHOOK_URL"; fi
  if [ -n "$CHANNEL" ]; then set -- "$@" --channel "$CHANNEL"; fi

  NODE_BIN=$(find_node) || NODE_BIN=""
  if [ -n "$NODE_BIN" ]; then
    # 显式解释器：不依赖调用方 PATH 里那份 node（hook 环境的 PATH 不一定是登录 shell 那套）
    if ! resolved=$("$NODE_BIN" "$cli" "$@"); then
      resolver_error
      return 2
    fi
  else
    if ! resolved=$("$cli" "$@"); then
      resolver_error
      return 2
    fi
  fi
  if [ -z "$resolved" ]; then
    echo "❌ 解析器没有输出地址。诊断：npx feishu-notify-cli doctor" >&2
    return 2
  fi
  printf '%s' "$resolved"
}

WEBHOOK_URL=$(resolve_webhook) || exit 2

# ========== 取卡片 footer（配置项；尽力而为，失败一律回退中性默认）==========
# text 模式没有 note 元素，因此完全不查 footer —— 少一次 node 启动，也少一处能失败的地方。
if [ "$MSG_TYPE" != "text" ]; then
  FOOTER=$(resolve_footer)
fi

# 发送
PAYLOAD=$(build_payload)
RESP=$(curl -s -w '\n%{http_code}' -X POST "$WEBHOOK_URL" \
  -H "Content-Type: application/json" \
  -d "$PAYLOAD")

HTTP_CODE=$(echo "$RESP" | tail -1)
BODY=$(echo "$RESP" | sed '$d')

if [ "$HTTP_CODE" = "200" ]; then
  echo "✅ 飞书消息已发送"
else
  echo "❌ 发送失败 (HTTP $HTTP_CODE): $BODY"
  exit 1
fi

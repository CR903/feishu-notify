{
  "name": "opencode-feishu-notify",
  "version": "0.1.0",
  "type": "module",
  "description": "OpenCode plugin: Feishu (Lark) notification cards when a turn ends or the agent needs you — sends through the feishu-notify CLI, which resolves the webhook from your own config (no address is ever compiled in)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/CR903/feishu-notify.git",
    "directory": "packages/opencode"
  },
  "bugs": {
    "url": "https://github.com/CR903/feishu-notify/issues"
  },
  "homepage": "https://github.com/CR903/feishu-notify#readme",
  "keywords": [
    "feishu",
    "lark",
    "notification",
    "notify",
    "webhook",
    "opencode",
    "opencode-plugin",
    "plugin",
    "claude-code"
  ],
  "main": "./src/feishu-notify.ts",
  "exports": {
    ".": "./src/feishu-notify.ts"
  },
  "files": [
    "src",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@opencode/plugin": ">=2.0.0"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "build": "bun build src/feishu-notify.ts --target node --outdir dist",
    "deploy": "node scripts/deploy.mjs",
    "deploy:check": "node scripts/deploy.mjs --check",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major"
  }
}

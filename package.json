{
  "name": "feishu-notify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for Feishu (Lark) bot notifications from local AI agents: the CLI + sender core, plus per-agent adapters (opencode, DSH)",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "secret-scan": "npm run secret-scan --workspace packages/cli",
    "fixtures": "npm run fixtures --workspace packages/cli",
    "fixtures:update": "npm run fixtures:update --workspace packages/cli"
  }
}
